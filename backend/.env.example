# Скопируйте в .env на сервере и заполните. Файл .env не коммитится.
BASE_PUBLIC_URL=https://fenixcraft.ru/api/launcher

# Секретный ключ подписи манифестов: python generate_signing_key.py
MANIFEST_SIGNING_KEY=
# Сервер не запустится без ключа. Выключите, только пока ключ ещё не создан.
REQUIRE_MANIFEST_SIGNING=true

# Сервисный токен приложения VK для новостей
VK_TOKEN=

# Приложение на dev.twitch.tv для статуса стрима
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=bloodrayt
