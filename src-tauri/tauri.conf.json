{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FenixCraft",
  "version": "1.0.8",
  "identifier": "ru.fenixcraft.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FenixCraft Launcher v1.0",
        "width": 1280,
        "height": 800,
        "minWidth": 1150,
        "minHeight": 720,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}