{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FenixCraft",
  "version": "1.0.22",
  "identifier": "ru.fenixcraft.launcher",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run build:css",
    "beforeBuildCommand": "npm run build:css"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FenixCraft Launcher",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost; frame-src https://player.twitch.tv https://www.twitch.tv; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer/sidebar.bmp",
        "headerImage": "icons/installer/header.bmp",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
